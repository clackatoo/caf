                    case "rate_limit_event": {
                        // CAF: Claude Code reports the limits from a response's
                        // headers, its startup quota probe's included, which come
                        // before the first prompt's turn is active. One that comes with
                        // no turn active is sent at once; one during a turn before its
                        // context is measured is held, not dropped, and sent once it
                        // is, or before the turn's answer, so all go in order.
                        heldLimits.push(message.rate_limit_info);
                        if (lastAssistantTotalUsage !== null || !session.activeTurn)
                            await sendHeldLimits();
                        break;
                    }
